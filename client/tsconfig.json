{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "../app/js",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "lib": ["es2020", "dom", "dom.iterable"],
    "sourceMap": false,
    "removeComments": false,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts"]
}
